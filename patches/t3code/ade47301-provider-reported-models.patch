+/**
+ * Binds and bounds provider-reported model evidence for one run of a thread read. Only `turnTokenUsage.models` of
+ * terminal turns on an attempt's own root node and provider thread count; the requested selection is never read.
+ */
+import type {
+  OrchestrationV2ProviderTurn,
+  OrchestrationV2Run,
+  OrchestrationV2RunAttempt,
+  OrchestratorMcpProviderReportedAttempt,
+  OrchestratorMcpRunProviderReportedModels,
+  RunAttemptId,
+} from "@t3tools/contracts";
+
+export const PROVIDER_REPORTED_ATTEMPT_LIMIT = 8;
+export const PROVIDER_REPORTED_MODEL_LIMIT = 8;
+export const PROVIDER_REPORTED_MODEL_MAX_LENGTH = 200;
+
+const TERMINAL_TURN_STATUSES: ReadonlySet<OrchestrationV2ProviderTurn["status"]> = new Set([
+  "completed",
+  "interrupted",
+  "failed",
+  "cancelled",
+]);
+
+/** The provider-turn load as the caller ran it. */
+export type ProviderTurnLoad =
+  | { readonly _tag: "skipped" }
+  | { readonly _tag: "loaded"; readonly turns: unknown }
+  | { readonly _tag: "failed" };
+
+const codeUnitOrder = (left: string, right: string) => (left < right ? -1 : left > right ? 1 : 0);
+
+/**
+ * This run's attempts in the loaded list, latest first, bounded. Returns `undefined` when no attempts list was
+ * loaded, so a missing list is never read as "no attempts".
+ */
+export function selectProviderReportedAttempts(
+  run: Pick<OrchestrationV2Run, "id">,
+  attempts: unknown,
+):
+  | { readonly owned: number; readonly selected: ReadonlyArray<OrchestrationV2RunAttempt> }
+  | undefined {
+  if (!Array.isArray(attempts)) return undefined;
+  const owned = (attempts as ReadonlyArray<OrchestrationV2RunAttempt>).filter(
+    (attempt) => attempt.runId === run.id,
+  );
+  const selected = owned
+    .toSorted(
+      (left, right) =>
+        right.attemptOrdinal - left.attemptOrdinal || codeUnitOrder(left.id, right.id),
+    )
+    .slice(0, PROVIDER_REPORTED_ATTEMPT_LIMIT);
+  return { owned: owned.length, selected };
+}
+
+/** A model id as reported: a trimmed string of 1-200 UTF-16 units, without control characters or lone surrogates. */
+export function isValidReportedModelId(value: unknown): value is string {
+  if (typeof value !== "string") return false;
+  if (value.length === 0 || value.length > PROVIDER_REPORTED_MODEL_MAX_LENGTH) return false;
+  if (value.trim() !== value) return false;
+  for (let index = 0; index < value.length; index += 1) {
+    const unit = value.charCodeAt(index);
+    if (unit <= 0x1f || (unit >= 0x7f && unit <= 0x9f)) return false;
+    if (unit >= 0xdc00 && unit <= 0xdfff) return false;
+    if (unit >= 0xd800 && unit <= 0xdbff) {
+      const next = value.charCodeAt(index + 1);
+      if (!(next >= 0xdc00 && next <= 0xdfff)) return false;
+      index += 1;
+    }
+  }
+  return true;
+}
+
+function attemptEvidence(
+  attempt: OrchestrationV2RunAttempt,
+  activeAttemptId: RunAttemptId | null,
+  turns: ReadonlyArray<OrchestrationV2ProviderTurn>,
+): OrchestratorMcpProviderReportedAttempt {
+  let rootTurns = 0;
+  let terminalRootTurns = 0;
+  let reportingRootTurns = 0;
+  let unboundTurns = 0;
+  let excludedModelValues = 0;
+  const models = new Set<string>();
+  for (const turn of turns) {
+    if (turn.runAttemptId === null || turn.runAttemptId !== attempt.id) continue;
+    if (turn.nodeId !== attempt.rootNodeId || turn.providerThreadId !== attempt.providerThreadId) {
+      unboundTurns += 1;
+      continue;
+    }
+    rootTurns += 1;
+    if (!TERMINAL_TURN_STATUSES.has(turn.status)) continue;
+    terminalRootTurns += 1;
+    const reported: unknown = turn.turnTokenUsage?.models;
+    if (!Array.isArray(reported)) continue;
+    let contributed = false;
+    for (const value of reported as ReadonlyArray<unknown>) {
+      if (isValidReportedModelId(value)) {
+        models.add(value);
+        contributed = true;
+      } else {
+        excludedModelValues += 1;
+      }
+    }
+    if (contributed) reportingRootTurns += 1;
+  }
+  const ordered = [...models].toSorted(codeUnitOrder);
+  return {
+    attemptId: attempt.id,
+    attemptOrdinal: attempt.attemptOrdinal,
+    reason: attempt.reason,
+    status: attempt.status,
+    active: activeAttemptId !== null && attempt.id === activeAttemptId,
+    providerInstanceId: attempt.providerInstanceId,
+    rootTurns,
+    terminalRootTurns,
+    reportingRootTurns,
+    unboundTurns,
+    modelEvidence: ordered.length > 0 ? "reported" : "unknown",
+    models: ordered.slice(0, PROVIDER_REPORTED_MODEL_LIMIT),
+    modelsOmitted: Math.max(0, ordered.length - PROVIDER_REPORTED_MODEL_LIMIT),
+    excludedModelValues,
+  };
+}
+
+/** The evidence for one run. A missing or failed load is reported as `unavailable`, never as an empty success. */
+export function providerReportedModels(input: {
+  readonly run: Pick<OrchestrationV2Run, "id" | "activeAttemptId">;
+  readonly attempts: unknown;
+  readonly turnLoad: ProviderTurnLoad;
+  readonly collectedAt: string;
+}): OrchestratorMcpRunProviderReportedModels {
+  const { run, collectedAt } = input;
+  const selection = selectProviderReportedAttempts(run, input.attempts);
+  if (selection === undefined) {
+    return { evidence: "unavailable", reason: "attempts_not_loaded", collectedAt };
+  }
+  let turns: ReadonlyArray<OrchestrationV2ProviderTurn> = [];
+  if (selection.selected.length > 0) {
+    if (input.turnLoad._tag === "failed") {
+      return { evidence: "unavailable", reason: "provider_turns_load_failed", collectedAt };
+    }
+    if (input.turnLoad._tag === "skipped" || !Array.isArray(input.turnLoad.turns)) {
+      return { evidence: "unavailable", reason: "provider_turns_not_loaded", collectedAt };
+    }
+    turns = input.turnLoad.turns as ReadonlyArray<OrchestrationV2ProviderTurn>;
+  }
+  return {
+    evidence: "collected",
+    collectedAt,
+    activeAttemptId: run.activeAttemptId,
+    attemptPolicy: "latest_by_attempt_ordinal",
+    attemptLimit: PROVIDER_REPORTED_ATTEMPT_LIMIT,
+    attemptsOwned: selection.owned,
+    attemptsOmitted: selection.owned - selection.selected.length,
+    attempts: selection.selected.map((attempt) =>
+      attemptEvidence(attempt, run.activeAttemptId, turns),
+    ),
+  };
+}
