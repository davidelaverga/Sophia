+    capabilities: new Set(["orchestration"]),
+    issuedAt: 1,
+  };
+
+  const run = (
+    ordinal: number,
+    status: OrchestrationV2Run["status"],
+    activeAttemptId: string | null,
+  ) =>
+    ({
+      id: RunId.make(`run:reported-${ordinal}`),
+      ordinal,
+      status,
+      modelSelection: { instanceId, model: REQUESTED },
+      activeAttemptId: activeAttemptId === null ? null : RunAttemptId.make(activeAttemptId),
+      requestedAt: EPOCH,
+      startedAt: null,
+      completedAt: null,
+    }) as unknown as OrchestrationV2Run;
+  const attempt = (
+    id: string,
+    runOrdinal: number,
+    attemptOrdinal: number,
+    reason: OrchestrationV2RunAttempt["reason"],
+    status: OrchestrationV2RunAttempt["status"],
+  ): OrchestrationV2RunAttempt => ({
+    id: RunAttemptId.make(id),
+    runId: RunId.make(`run:reported-${runOrdinal}`),
+    attemptOrdinal,
+    rootNodeId: NodeId.make(`node:root:${id}`),
+    providerInstanceId: instanceId,
+    providerThreadId: ProviderThreadId.make(`provider-thread:${id}`),
+    providerTurnId: null,
+    reason,
+    status,
+    startedAt: null,
+    completedAt: null,
+  });
+  let turnOrdinal = 0;
+  /** A provider turn. `models: "erased"` drops turnTokenUsage, as the store's upsert hazard can. */
+  const turn = (
+    owner: OrchestrationV2RunAttempt | null,
+    status: OrchestrationV2ProviderTurn["status"],
+    models: ReadonlyArray<unknown> | "erased" | "absent",
+    binding: { readonly node?: string; readonly providerThread?: string } = {},
+  ) => {
+    turnOrdinal += 1;
+    return {
+      id: ProviderTurnId.make(`provider-turn:${turnOrdinal}`),
+      providerThreadId:
+        binding.providerThread === undefined
+          ? (owner?.providerThreadId ?? ProviderThreadId.make("provider-thread:child"))
+          : ProviderThreadId.make(binding.providerThread),
+      nodeId:
+        binding.node === undefined
+          ? (owner?.rootNodeId ?? NodeId.make("node:child"))
+          : NodeId.make(binding.node),
+      runAttemptId: owner?.id ?? null,
+      nativeTurnRef: null,
+      ordinal: turnOrdinal,
+      status,
+      startedAt: null,
+      completedAt: null,
+      ...(models === "erased"
+        ? {}
+        : {
+            turnTokenUsage: {
+              usageScope: "main_agent",
+              hasSubagents: false,
+              usageStatus: "complete",
+              inputTokens: 1,
+              outputTokens: 1,
+              ...(models === "absent" ? {} : { models }),
+            },
+          }),
+    } as unknown as OrchestrationV2ProviderTurn;
+  };
+
+  type Call = { readonly fields: ReadonlyArray<string>; readonly filter: unknown };
+  /**
+   * A LABELLED FAKE ThreadManagementService. Its provider-turn load applies providerTurnAttemptIds as the store's
+   * SQL does (run_attempt_id IN ...), so a null-attempt turn is never returned. `turns: "fail"` fails that load and
+   * `turns: "omit"` returns no providerTurns key; `attempts: "omit"` ignores the requested fields as a fake would.
+   */
+  const readWith = (
+    fixture: {
+      readonly runs: ReadonlyArray<OrchestrationV2Run>;
+      readonly attempts: ReadonlyArray<OrchestrationV2RunAttempt> | "omit";
+      readonly turns: ReadonlyArray<OrchestrationV2ProviderTurn> | "fail" | "omit";
+    },
+    runLimit?: number,
+  ) =>
+    Effect.gen(function* () {
+      const calls: Array<Call> = [];
+      const { attempts: _attempts, ...base } = idleThreadProjection(shell);
+      const layer = layerOrchestratorService.pipe(
+        Layer.provide(
+          Layer.mergeAll(
+            NodeServices.layer,
+            NodeCrypto.layer,
+            Layer.mock(ThreadManagementService.ThreadManagementService)({
+              getThreadShell: (id) => Effect.succeed(id === threadId ? shell : null),
+              getTimelinePage: () => Effect.succeed({ items: [], totalItems: 0, hasMore: false }),
+              getProjectThreadRecords: (input, fields, filter) => {
+                calls.push({ fields: [...fields], filter });
+                if (input.threadId !== threadId) return Effect.die(`unexpected ${input.threadId}`);
+                if (!(fields as ReadonlyArray<string>).includes("providerTurns")) {
+                  return Effect.succeed({
+                    ...base,
+                    runs: fixture.runs,
+                    ...(fixture.attempts === "omit" ? {} : { attempts: fixture.attempts }),
+                  } as never);
+                }
+                if (fixture.turns === "fail") {
+                  return Effect.fail(
+                    new ThreadManagementService.ThreadManagementProjectionLoadError({
+                      projectId: input.projectId,
+                      threadId: input.threadId,
+                      cause: "synthetic provider-turn load failure",
+                    }),
+                  );
+                }
+                if (fixture.turns === "omit")
+                  return Effect.succeed({ thread: base.thread } as never);
+                const ids = filter?.providerTurnAttemptIds;
+                return Effect.succeed({
+                  thread: base.thread,
+                  providerTurns:
+                    ids === undefined
+                      ? fixture.turns
+                      : fixture.turns.filter(
+                          (row) => row.runAttemptId !== null && ids.includes(row.runAttemptId),
+                        ),
+                } as never);
+              },
+            }),
+            ServerSettings.layerTest(),
+            Layer.mock(ProviderRegistry.ProviderRegistry)({ getProviders: Effect.succeed([]) }),
+            Layer.mock(ProviderAdapterRegistry.ProviderAdapterRegistryV2)({
+              list: () => Effect.succeed([]),
+            }),
+            Layer.mock(ProjectService.ProjectService)({}),
+            Layer.mock(SecretRequests.SecretRequests)({}),
+            Layer.mock(RemoteDelegation.RemoteDelegation)({}),
+            Layer.mock(ScheduledTaskService.ScheduledTaskService)({}),
+          ),
+        ),
+      );
+      const result = yield* Effect.gen(function* () {
+        const mcp = yield* OrchestratorMcpService.OrchestratorMcpService;
+        return yield* mcp.readThread(client, {
+          threadId,
+          ...(runLimit === undefined ? {} : { runLimit }),
+        });
+      }).pipe(Effect.provide(layer));
+      return { result, calls };
+    });
+
+  const byOrdinal = (result: OrchestratorMcpThreadReadResult, ordinal: number) => {
+    const found = result.recentRuns.find((row) => row.ordinal === ordinal);
+    assert.isDefined(found);
+    return found!.providerReportedModels;
+  };
+  const collected = (result: OrchestratorMcpThreadReadResult, ordinal: number) => {
+    const evidence = byOrdinal(result, ordinal);
+    assert.equal(evidence?.evidence, "collected");
+    return evidence as Extract<NonNullable<typeof evidence>, { evidence: "collected" }>;
+  };
+  const keysOf = (value: unknown): Array<string> =>
+    Array.isArray(value)
+      ? value.flatMap(keysOf)
+      : typeof value === "object" && value !== null
+        ? Object.entries(value).flatMap(([key, inner]) => [key, ...keysOf(inner)])
+        : [];
+
+  // Four runs; the read returns the latest three. Run 2 restarted once, run 3 has no attempt yet.
+  const a1 = attempt("attempt:r1", 1, 1, "initial", "completed");
+  const a2a = attempt("attempt:r2-initial", 2, 1, "initial", "superseded");
+  const a2b = attempt("attempt:r2-restart", 2, 2, "steering_restart", "completed");
+  const a4 = attempt("attempt:r4", 4, 1, "initial", "running");
+  const scenario = () => ({
+    runs: [
+      run(1, "completed", a1.id),
+      run(2, "completed", a2b.id),
+      run(3, "queued", null),
+      run(4, "running", a4.id),
+    ],
+    attempts: [a1, a2a, a2b, a4],
+    turns: [
+      turn(a1, "completed", ["model-outside-the-run-limit"]),
+      turn(a2a, "completed", ["model-b", "model-a", "model-b"]),
+      turn(a2a, "interrupted", ["model-c", "", " padded", 42]),
+      turn(a2a, "completed", ["model-foreign"], { providerThread: "provider-thread:foreign" }),
+      turn(a2b, "completed", ["model-z"]),
+      turn(a2b, "completed", ["model-subagent"], { node: "node:subagent" }),
+      turn(a2b, "completed", "erased"),
+      turn(a2b, "completed", []),
+      turn(a2b, "failed", "absent"),
+      turn(a2b, "pending", ["model-pending"]),
+      turn(null, "completed", ["model-child"]),
+      turn(a4, "running", ["model-in-flight"]),
+    ],
+  });
+
+  it.effect(
+    "reports each attempt's terminal root-turn models separately, bound to the read's own runs",
+    () =>
+      Effect.gen(function* () {
+        const { result, calls } = yield* readWith(scenario(), 3);
+        assert.deepEqual(
+          calls.map((call) => call.fields),
+          [["runs", "runtimeRequests", "attempts"], ["providerTurns"]],
+        );
+        // Only the selected attempts of the returned runs, latest run and attempt first; never an undefined filter.
+        assert.deepEqual(calls[1]?.filter, {
+          providerTurnAttemptIds: [a4.id, a2b.id, a2a.id],
+        });
+        assert.deepEqual(
+          result.recentRuns.map((row) => [row.ordinal, row.model]),
+          [
+            [4, REQUESTED],
+            [3, REQUESTED],
+            [2, REQUESTED],
+          ],
+          "model stays the requested selection",
+        );
+
+        const restarted = collected(result, 2);
+        assert.equal(restarted.activeAttemptId, a2b.id);
+        assert.deepEqual(
+          [
+            restarted.attemptPolicy,
+            restarted.attemptLimit,
+            restarted.attemptsOwned,
+            restarted.attemptsOmitted,
+          ],
+          ["latest_by_attempt_ordinal", 8, 2, 0],
+        );
+        assert.deepEqual(restarted.attempts, [
+          {
+            attemptId: a2b.id,
+            attemptOrdinal: 2,
+            reason: "steering_restart",
+            status: "completed",
+            active: true,
+            providerInstanceId: instanceId,
+            rootTurns: 5,
+            terminalRootTurns: 4,
+            reportingRootTurns: 1,
+            unboundTurns: 1,
+            modelEvidence: "reported",
+            models: ["model-z"],
+            modelsOmitted: 0,
+            excludedModelValues: 0,
+          },
+          {
+            attemptId: a2a.id,
+            attemptOrdinal: 1,
+            reason: "initial",
+            status: "superseded",
+            active: false,
+            providerInstanceId: instanceId,
+            rootTurns: 2,
+            terminalRootTurns: 2,
+            reportingRootTurns: 2,
+            unboundTurns: 1,
+            modelEvidence: "reported",
+            models: ["model-a", "model-b", "model-c"],
+            modelsOmitted: 0,
+            excludedModelValues: 3,
+          },
+        ]);
+
+        const queued = collected(result, 3);
+        assert.deepEqual(
+          [queued.activeAttemptId, queued.attemptsOwned, queued.attempts],
+          [null, 0, []],
+        );
+
+        const running = collected(result, 4);
+        assert.deepEqual(
+          running.attempts.map((row) => [
+            row.attemptId,
+            row.active,
+            row.rootTurns,
+            row.terminalRootTurns,
+            row.modelEvidence,
+            row.models,
+          ]),
+          [[a4.id, true, 1, 0, "unknown", []]],
+          "a running root turn is counted but its models are not read",
+        );
+
+        const evidence = JSON.stringify(result.recentRuns.map((row) => row.providerReportedModels));
+        for (const absent of [
+          REQUESTED,
+          "gpt-5",
+          "model-child",
+          "model-subagent",
+          "model-foreign",
+          "model-pending",
+          "model-in-flight",
+          "model-outside-the-run-limit",
+        ]) {
+          assert.notInclude(evidence, absent);
+        }
+        const keys = new Set(keysOf(result.recentRuns.map((row) => row.providerReportedModels)));
+        for (const forbidden of [
+          "complete",
+          "completed",
+          "final",
+          "finalized",
+          "accepted",
+          "effort",
+        ]) {
+          assert.isFalse(keys.has(forbidden), `no ${forbidden} key`);
+        }
+        const stamps = new Set(
+          result.recentRuns.map((row) => row.providerReportedModels?.collectedAt),
+        );
+        assert.deepEqual([...stamps], [DateTime.formatIso(EPOCH)], "one collection time per read");
+        // The whole result still decodes through the published schema.
+        yield* decodeThreadReadResult(result);
+      }),
+  );
+
+  it.effect("a failed provider-turn load is unavailable evidence, never an empty success", () =>
+    Effect.gen(function* () {
+      const { result, calls } = yield* readWith({ ...scenario(), turns: "fail" }, 3);
