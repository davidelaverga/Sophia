+        assert.deepEqual(row.providerReportedModels, {
+          evidence: "unavailable",
+          reason: "attempts_not_loaded",
+          collectedAt: DateTime.formatIso(EPOCH),
+        });
+      }
+      const omittedTurns = yield* readWith({ ...scenario(), turns: "omit" }, 3);
+      assert.equal(byOrdinal(omittedTurns.result, 2)?.evidence, "unavailable");
+      assert.deepEqual(byOrdinal(omittedTurns.result, 4), {
+        evidence: "unavailable",
+        reason: "provider_turns_not_loaded",
+        collectedAt: DateTime.formatIso(EPOCH),
+      });
+    }),
+  );
+
+  it.effect("bounds attempts, models and ids, and records what it left out", () =>
+    Effect.gen(function* () {
+      const attempts = Array.from({ length: 10 }, (_, index) =>
+        attempt(
+          `attempt:bounded-${String(index + 1).padStart(2, "0")}`,
+          1,
+          index + 1,
+          "retry",
+          "failed",
+        ),
+      );
+      const latest = attempts[9]!;
+      const many = Array.from({ length: 10 }, (_, index) => `model-${String(9 - index)}`);
+      const { result, calls } = yield* readWith({
+        runs: [run(1, "failed", latest.id)],
+        attempts,
+        turns: [
+          turn(latest, "completed", [...many, "x".repeat(201), "x".repeat(200), "Model-0"]),
+          turn(attempts[0]!, "completed", ["model-of-an-omitted-attempt"]),
+        ],
+      });
+      assert.deepEqual(
+        calls[1]?.filter,
+        {
+          providerTurnAttemptIds: attempts
+            .toReversed()
+            .slice(0, 8)
+            .map((row) => row.id),
+        },
+        "only the eight latest attempts are loaded",
+      );
+      const bounded = collected(result, 1);
+      assert.deepEqual(
+        [bounded.attemptsOwned, bounded.attemptsOmitted, bounded.attempts.length],
+        [10, 2, 8],
+      );
+      assert.deepEqual(
+        bounded.attempts.map((row) => row.attemptOrdinal),
+        [10, 9, 8, 7, 6, 5, 4, 3],
+      );
+      const top = bounded.attempts[0]!;
+      // Code-unit order: "M" < "m" < "x"; exact strings, no case folding.
+      assert.deepEqual(top.models, [
+        "Model-0",
+        "model-0",
+        "model-1",
+        "model-2",
+        "model-3",
+        "model-4",
+        "model-5",
+        "model-6",
+      ]);
+      assert.deepEqual([top.modelsOmitted, top.excludedModelValues], [4, 1]);
+      assert.notInclude(JSON.stringify(bounded), "model-of-an-omitted-attempt");
+      yield* decodeThreadReadResult(result);
+    }),
+  );
+
+  it("is additive: a run without the field still decodes, and the field never replaces model", () => {
+    const legacy = {
+      runId: "run:legacy",
+      ordinal: 1,
+      status: "completed",
+      providerInstanceId: "codex",
+      model: REQUESTED,
+      requestedAt: "1970-01-01T00:00:00.000Z",
+      startedAt: null,
+      completedAt: null,
+    };
+    const decoded = decodeThreadRun(legacy);
+    assert.isUndefined(decoded.providerReportedModels);
+    assert.equal(decoded.model, REQUESTED);
+    assert.throws(() =>
+      decodeThreadRun({
+        ...legacy,
+        providerReportedModels: { evidence: "collected", collectedAt: "x" },
+      }),
+    );
+  });
+});
