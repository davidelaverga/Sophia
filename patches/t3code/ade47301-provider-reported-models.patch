+import { describe, expect, it } from "@effect/vitest";
+import {
+  NodeId,
+  type OrchestrationV2ProviderTurn,
+  type OrchestrationV2RunAttempt,
+  ProviderInstanceId,
+  ProviderThreadId,
+  ProviderTurnId,
+  RunAttemptId,
+  RunId,
+} from "@t3tools/contracts";
+
+import {
+  isValidReportedModelId,
+  providerReportedModels,
+  selectProviderReportedAttempts,
+} from "./providerReportedModels.ts";
+
+const runId = RunId.make("run:pure");
+const run = { id: runId, activeAttemptId: RunAttemptId.make("attempt:pure-2") };
+const attempt = (id: string, attemptOrdinal: number, owner = runId): OrchestrationV2RunAttempt => ({
+  id: RunAttemptId.make(id),
+  runId: owner,
+  attemptOrdinal,
+  rootNodeId: NodeId.make(`node:${id}`),
+  providerInstanceId: ProviderInstanceId.make("claude"),
+  providerThreadId: ProviderThreadId.make(`provider-thread:${id}`),
+  providerTurnId: null,
+  reason: attemptOrdinal === 1 ? "initial" : "provider_recovery",
+  status: "completed",
+  startedAt: null,
+  completedAt: null,
+});
+const turn = (
+  owner: OrchestrationV2RunAttempt,
+  models: unknown,
+  override: Partial<
+    Record<"runAttemptId" | "nodeId" | "providerThreadId" | "status", unknown>
+  > = {},
+) =>
+  ({
+    id: ProviderTurnId.make(`provider-turn:${owner.id}:${JSON.stringify(models)}`),
+    providerThreadId: owner.providerThreadId,
+    nodeId: owner.rootNodeId,
+    runAttemptId: owner.id,
+    nativeTurnRef: null,
+    ordinal: 1,
+    status: "completed",
+    startedAt: null,
+    completedAt: null,
+    turnTokenUsage: {
+      usageScope: "main_agent",
+      hasSubagents: false,
+      usageStatus: "partial",
+      models,
+    },
+    ...override,
+  }) as unknown as OrchestrationV2ProviderTurn;
+
+const first = attempt("attempt:pure-1", 1);
+const second = attempt("attempt:pure-2", 2);
+const evidence = (turns: unknown, attempts: unknown = [first, second]) =>
+  providerReportedModels({
+    run,
+    attempts,
+    turnLoad: { _tag: "loaded", turns },
+    collectedAt: "2026-11-13T00:00:00.000Z",
+  });
+const attemptsOf = (value: ReturnType<typeof evidence>) => {
+  expect(value.evidence).toBe("collected");
+  return value.evidence === "collected" ? value.attempts : [];
+};
+
+describe("providerReportedModels (pure binding and bounds)", () => {
+  it("excludes every turn that is not the attempt's own root turn", () => {
+    const [latest, earlier] = attemptsOf(
+      evidence([
+        turn(second, ["root"]),
+        turn(second, ["null-attempt"], { runAttemptId: null }),
+        turn(second, ["child-node"], { nodeId: NodeId.make("node:child") }),
+        turn(second, ["other-thread"], {
+          providerThreadId: ProviderThreadId.make("provider-thread:other"),
+        }),
+        turn(second, ["other-run-attempt"], { runAttemptId: RunAttemptId.make("attempt:other") }),
+        turn(first, ["earlier-root"]),
+      ]),
+    );
+    expect(latest).toMatchObject({ models: ["root"], rootTurns: 1, unboundTurns: 2, active: true });
+    expect(earlier).toMatchObject({ models: ["earlier-root"], rootTurns: 1, active: false });
+  });
+
+  it("keeps attempts apart: a restart's models are never merged into another attempt", () => {
+    const [latest, earlier] = attemptsOf(evidence([turn(first, ["m-1"]), turn(second, ["m-2"])]));
+    expect([latest?.models, earlier?.models]).toEqual([["m-2"], ["m-1"]]);
+  });
+
+  it("reads terminal root turns only, and never reports unknown as none", () => {
+    for (const status of ["pending", "running"]) {
+      const [latest] = attemptsOf(evidence([turn(second, ["in-flight"], { status })]));
+      expect(latest).toMatchObject({
+        rootTurns: 1,
+        terminalRootTurns: 0,
+        modelEvidence: "unknown",
+        models: [],
+      });
+    }
+    for (const status of ["completed", "interrupted", "failed", "cancelled"]) {
+      const [latest] = attemptsOf(evidence([turn(second, ["done"], { status })]));
+      expect(latest).toMatchObject({ terminalRootTurns: 1, modelEvidence: "reported" });
+    }
+    for (const models of [undefined, [], ["", " x", "x\n", "\u0085", "\ud800", 7, null]]) {
+      const [latest] = attemptsOf(evidence([turn(second, models)]));
+      expect(latest).toMatchObject({
+        terminalRootTurns: 1,
+        reportingRootTurns: 0,
+        modelEvidence: "unknown",
+      });
+    }
+    const [noUsage] = attemptsOf(
+      evidence([turn(second, ["dropped"], { turnTokenUsage: undefined } as never)]),
+    );
+    expect(noUsage).toMatchObject({ terminalRootTurns: 1, modelEvidence: "unknown", models: [] });
+  });
+
+  it("dedupes exact strings and orders by code unit", () => {
+    const [latest] = attemptsOf(evidence([turn(second, ["b", "B", "a", "b", "é", "é", "😀"])]));
+    expect(latest?.models).toEqual(["B", "a", "b", "é", "é", "😀"]);
+  });
+
+  it("validates ids exactly", () => {
+    expect(isValidReportedModelId("x".repeat(200))).toBe(true);
+    expect(isValidReportedModelId("😀")).toBe(true);
+    for (const value of [
+      "",
+      "x".repeat(201),
+      " x",
+      "x ",
+      "a\tb",
+      "\u007f",
+      "\udc00",
+      "a\ud800",
+      1,
+      null,
+    ]) {
+      expect(isValidReportedModelId(value)).toBe(false);
+    }
+  });
+
+  it("selects the latest eight attempts of the run only, and counts what it left out", () => {
+    const attempts = [
+      ...Array.from({ length: 9 }, (_, index) => attempt(`attempt:many-${index + 1}`, index + 1)),
+      attempt("attempt:another-run", 99, RunId.make("run:other")),
+    ];
+    const selection = selectProviderReportedAttempts(run, attempts);
+    expect(selection?.owned).toBe(9);
+    expect(selection?.selected.map((row) => row.attemptOrdinal)).toEqual([9, 8, 7, 6, 5, 4, 3, 2]);
+    expect(selectProviderReportedAttempts(run, undefined)).toBeUndefined();
+    const value = evidence([], attempts);
+    expect(value).toMatchObject({ attemptsOwned: 9, attemptsOmitted: 1 });
+  });
+
+  it("never turns a missing or failed load into an empty success", () => {
+    const base = { run, collectedAt: "t" } as const;
+    expect(
+      providerReportedModels({ ...base, attempts: undefined, turnLoad: { _tag: "skipped" } }),
+    ).toEqual({ evidence: "unavailable", reason: "attempts_not_loaded", collectedAt: "t" });
+    expect(
+      providerReportedModels({ ...base, attempts: [second], turnLoad: { _tag: "failed" } }),
+    ).toEqual({ evidence: "unavailable", reason: "provider_turns_load_failed", collectedAt: "t" });
+    for (const turnLoad of [
+      { _tag: "skipped" } as const,
+      { _tag: "loaded", turns: undefined } as const,
+    ]) {
+      expect(providerReportedModels({ ...base, attempts: [second], turnLoad })).toEqual({
+        evidence: "unavailable",
+        reason: "provider_turns_not_loaded",
+        collectedAt: "t",
+      });
+    }
+    // No attempt of this run: an empty list is what the read returned, whatever the turn load did.
+    expect(
+      providerReportedModels({ ...base, attempts: [], turnLoad: { _tag: "failed" } }),
+    ).toMatchObject({ evidence: "collected", attempts: [], attemptsOwned: 0 });
+  });
+});
