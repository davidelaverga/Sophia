+// A host that refuses to exec a file makes Node's spawn throw EPERM synchronously (syscall "spawn"),
+// as a sandbox profile denying setuid-marked executables does for macOS's /bin/ps. The Node spawner
+// calls spawn inside Effect.callback, so the refusal arrives as a defect, which orElseSucceed does
+// not absorb. Only a cause that is exactly that one defect matches; interruption never does.
+const isRefusedSpawn = (cause: Cause.Cause<never>) => {
+  const [reason, ...others] = cause.reasons;
+  if (reason === undefined || others.length > 0 || !Cause.isDieReason(reason)) return false;
+  const defect = reason.defect;
+  return (
+    defect instanceof Error &&
+    (defect as NodeJS.ErrnoException).code === "EPERM" &&
+    (defect as NodeJS.ErrnoException).syscall === "spawn"
+  );
+};
