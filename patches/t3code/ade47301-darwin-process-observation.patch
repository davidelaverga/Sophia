+// A confined macOS host refuses to exec the setuid /bin/ps: Node's spawn throws EPERM synchronously
+// (syscall "spawn"). These tests keep the real Node spawner and answer only its /bin/ps call that way.
+const nodeChildProcess = NodeModule.createRequire(import.meta.url)(
+  "node:child_process",
+) as typeof NodeChildProcess;
+
+const errnoException = (code: string, syscall: string) =>
+  Object.assign(new Error(`${syscall} ${code}`), { errno: -1, code, syscall });
+
+const answerPs = (
+  answer: (original: typeof NodeChildProcess.spawn) => NodeChildProcess.ChildProcess,
+) =>
+  Effect.acquireRelease(
+    Effect.sync(() => {
+      const original = nodeChildProcess.spawn;
+      nodeChildProcess.spawn = ((file: string, ...rest: ReadonlyArray<unknown>) =>
+        file === "/bin/ps"
+          ? answer(original)
+          : Reflect.apply(original, nodeChildProcess, [file, ...rest])) as typeof original;
+      NodeModule.syncBuiltinESMExports();
+      return original;
+    }),
+    (original) =>
+      Effect.sync(() => {
+        nodeChildProcess.spawn = original;
+        NodeModule.syncBuiltinESMExports();
+      }),
+  );
