+        }
+      }).pipe(provideDarwin),
+    );
+
+    it.live("stays interruptible while it observes its own process", () =>
+      capturingWarnings((warnings) =>
+        Effect.gen(function* () {
+          const fs = yield* FileSystem.FileSystem;
+          const stateDir = yield* fs.makeTempDirectoryScoped({ prefix: "t3-opencode-ledger-" });
+          const observing = yield* Deferred.make<number>();
+          // A ps that never answers: the observation is still running when startup is interrupted.
+          yield* answerPs((original) => {
+            const child = original("/bin/sh", ["-c", "sleep 600"], { stdio: "ignore" });
