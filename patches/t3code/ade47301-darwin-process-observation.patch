+              process.kill(pid, "SIGKILL");
+            } catch {}
+          });
+          // An interrupted observation is not a refused one: no unknown owner is claimed.
+          expect(warnings.filter((w) => w.startsWith(OWNER_UNKNOWN))).toEqual([]);
+        }),
+      ).pipe(provideDarwin),
+    );
+  },
+);
