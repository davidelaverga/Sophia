node_modules/
dist/
*.tsbuildinfo
# Build outputs: produced by `pnpm artifacts`, identified by digest in
# config/runtime-unit.json, never committed.
/.artifacts/
# Local runtime homes and dsh logs are runtime data, not source.
/.dsh-home/
/.runtime/
.env
.env.*
!.env.example
# Invitation emails written by the local dev stack (SOPHIA_MAIL_DIR), never sent.
/.sophia-mail/
# Playwright's run outputs (apps/studio/e2e): results and traces of a local run.
/apps/studio/test-results/
/apps/studio/playwright-report/
# Python bytecode from running the UML launchers' unit tests locally.
__pycache__/
