  "view": {
    "definition": " SELECT j.project_id,\n    j.id,\n    j.kind,\n    a.goal_id,\n    j.attempt_id,\n    j.command_id,\n    c.actor_id,\n    j.state,\n    j.created_at,\n    j.input_source_id,\n    j.result_source_id,\n    j.reason,\n    c.body_source_id AS instruction_source_id,\n        CASE\n            WHEN ((c.state = 'denied'::text) AND (j.state = ANY (ARRAY['pending'::text, 'cancelled'::text]))) THEN 'denied'::text\n            WHEN (g.status = 'holding'::text) THEN 'holding'::text\n            WHEN (g.status = 'held'::text) THEN 'held'::text\n            WHEN (g.status = 'stopping'::text) THEN 'stopping'::text\n            WHEN (g.status = 'stopped'::text) THEN 'stopped'::text\n            WHEN (j.state = 'succeeded'::text) THEN 'result_ready'::text\n            WHEN (j.state = 'failed'::text) THEN 'failed'::text\n            WHEN (j.state = 'outcome_unknown'::text) THEN 'outcome_unknown'::text\n            WHEN (b.state = 'created'::text) THEN 'queued'::text\n            WHEN (b.state = 'launching'::text) THEN 'dispatched'::text\n            ELSE 'running'::text\n        END AS phase,\n    ( SELECT COALESCE(array_agg(d.source_id ORDER BY d.source_id), '{}'::uuid[]) AS \"coalesce\"\n           FROM (sophia.source_dependencies d\n             JOIN sophia.contributions ct ON (((ct.project_id = d.project_id) AND (ct.source_id = d.source_id))))\n          WHERE ((d.project_id = j.project_id) AND (d.derived_source_id = j.input_source_id))) AS input_source_ids,\n    j.artifact_id\n   FROM ((((sophia.jobs j\n     JOIN sophia.work_attempts a ON (((a.project_id = j.project_id) AND (a.id = j.attempt_id))))\n     JOIN sophia.goals g ON (((g.project_id = a.project_id) AND (g.id = a.goal_id))))\n     JOIN sophia.commands c ON (((c.project_id = j.project_id) AND (c.id = j.command_id))))\n     LEFT JOIN sophia.execution_bindings b ON (((b.project_id = a.project_id) AND (b.attempt_id = a.id))))\n  WHERE (sophia.is_task_kind(j.kind) AND (j.parent_job_id IS NULL));",
    "definition_md5": "c0d03ea473637eab9be98b68e0216d65",
    "reloptions": [
      "security_barrier=true",
      "security_invoker=true"
    ]
  },
  "functions": [
    {
      "signature": "sophia.actor_id()",
      "definition": "CREATE OR REPLACE FUNCTION sophia.actor_id()\n RETURNS uuid\n LANGUAGE sql\n STABLE\n SET search_path TO 'pg_catalog'\nAS $function$ SELECT nullif(current_setting('sophia.actor_id',true),'')::uuid $function$\n",
      "definition_md5": "27098852bf55bc01c3c6b938a646491c"
    },
    {
      "signature": "sophia.is_member(uuid)",
      "definition": "CREATE OR REPLACE FUNCTION sophia.is_member(p_project uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sophia'\nAS $function$ SELECT EXISTS(SELECT 1 FROM sophia.project_members WHERE project_id=p_project AND actor_id=sophia.actor_id() AND active) $function$\n",
      "definition_md5": "73e40f4a2d8d6af95f8d414c6c2ee784"
    },
    {
      "signature": "sophia.is_task_kind(text)",
      "definition": "CREATE OR REPLACE FUNCTION sophia.is_task_kind(p_kind text)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE\n SET search_path TO 'pg_catalog'\nAS $function$\n SELECT p_kind IN ('draft_brief','research','design') $function$\n",
      "definition_md5": "ab5390873bf78035cc94d99466f49d12"
    },
    {
      "signature": "sophia.mission_capture_default()",
      "definition": "CREATE OR REPLACE FUNCTION sophia.mission_capture_default()\n RETURNS text\n LANGUAGE sql\n IMMUTABLE\n SET search_path TO 'pg_catalog'\nAS $function$ SELECT 'automatic'::text $function$\n",
      "definition_md5": "d3212aa604efc9363d7d30e4ee0777a5"
    }
