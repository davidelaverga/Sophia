{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Small accepted/proposed work plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "sophia.work.plan.v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "mission_revision": {
      "type": "integer",
      "minimum": 0
    },
    "source_manifest_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "state": {
      "enum": [
        "proposed",
        "accepted",
        "superseded",
        "withdrawn"
      ]
    },
    "decision_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "deliverable_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "criteria_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true,
            "maxItems": 200
          },
          "assignee_kind": {
            "enum": [
              "assignment",
              "human",
              "unassigned"
            ]
          },
          "assignee_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "source_scope_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "review_policy_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "recipe_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "activation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "immediate",
                  "dependencies_satisfied",
                  "candidate_ready"
                ]
              },
              "producer_work_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "producer_work_id"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "candidate_ready"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "producer_work_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "purpose",
          "deliverable_ref",
          "criteria_ref",
          "parent_id",
          "blocked_by",
          "assignee_kind",
          "assignee_id",
          "source_scope_ref",
          "review_policy_ref",
          "recipe_ref",
          "activation"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "revision",
    "mission_revision",
    "source_manifest_ref",
    "state",
    "decision_ref",
    "items"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "decision_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  ]
}
