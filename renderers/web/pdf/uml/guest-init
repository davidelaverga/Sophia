#!/bin/busybox sh
set -eu
export PATH=/bin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /target
mount -t ext4 -o ro,noload /dev/ubda /target
mount -t proc proc /target/proc
mount -t sysfs sysfs /target/sys
mount -t devtmpfs devtmpfs /target/dev
mount -t tmpfs tmpfs /target/tmp
mount -t tmpfs tmpfs /target/run
mount -t tmpfs tmpfs /target/work
cp /bin/busybox /target/run/busybox
cp /guest-run /target/run/guest-run
mkdir -p /target/run/uml
cp /diagnostic.mjs /target/run/uml/diagnostic.mjs
ln -s /opt/renderer/confine.mjs /target/run/confine.mjs
ln -s /opt/renderer/host-probe.mjs /target/run/host-probe.mjs
ln -s /opt/renderer/capture-html.mjs /target/run/capture-html.mjs
cp /abi-probe /target/run/abi-probe
umount /sys
umount /proc
umount /dev
exec switch_root /target /run/busybox sh /run/guest-run
