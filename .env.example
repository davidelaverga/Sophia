# Copy to .env for local development. Never commit real values.
# Secrets for deployed services live in each platform's secret store (ops/DEPLOYMENT_BINDINGS).

# Disposable local database only (scripts/db-test.ts). Never the legacy Sophia database.
SOPHIA_DISPOSABLE_DATABASE_URL=

# apps/api (S1-02). A login granted sophia_api — never the migration owner or a service-role key.
# Hosted: session pooler + verify-full, e.g.
# postgresql://sophia_api_app.<ref>:<pw>@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=deploy/supabase/prod-ca-2021.crt
SOPHIA_API_DATABASE_URL=
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Prefer asymmetric signing keys; the HS256 secret is the legacy fallback.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
PORT=8787

# apps/api room access (S1-04A). Invitation links are derived from this secret (at least 32 random
# characters, e.g. `openssl rand -hex 32`); without it, invitations answer 503. Links open STUDIO_URL/join#…
# (defaults to the first STUDIO_ORIGINS entry).
INVITE_TOKEN_SECRET=
STUDIO_URL=
# Invitation email through Resend (a sending-only key and a verified domain). Without it, invitations are
# still created and say the email is not set up. Locally, SOPHIA_MAIL_DIR writes each email to files instead.
RESEND_API_KEY=
INVITE_FROM=Sophia <rooms@your-domain.example>
SOPHIA_MAIL_DIR=

# apps/worker (S1-05A): runtime dispatch, and taking declined guests out of the call (it reads the same LIVEKIT_URL,
# LIVEKIT_API_KEY and LIVEKIT_API_SECRET as the API; without them removals stay pending, visibly).
# A login granted sophia_worker — never the API login or the owner.
SOPHIA_WORKER_DATABASE_URL=

# Execution host (S1-05A, scripts/runtime-host.mjs): the API it binds to and the runtime capability that
# scripts/register-runtime.ts printed once. Secret store only; the model key (OPENAI_API_KEY) is passed by name.
SOPHIA_SERVICE_URL=
SOPHIA_RUNTIME_TOKEN=

# LiveKit (S1-04 rooms; S1-05A the bridge's token and guest removal). The API and the worker read the same three;
# the browser only ever receives short-lived room tokens.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The media bridge (S1-05A). The API holds only the SHA-256 (64 lowercase hex) of the bridge's capability;
# without it, /v1/media/* answers 401 and Sophia cannot join a room.
SOPHIA_MEDIA_BRIDGE_TOKEN_SHA256=

# apps/media-bridge (S1-05A): the API's private URL (SOPHIA_SERVICE_URL above), the capability itself, and the
# Gemini API key on an authorized host only. SOPHIA_LIVE_MODE=rehearse is local development: no Google call.
SOPHIA_MEDIA_BRIDGE_TOKEN=
GEMINI_API_KEY=
SOPHIA_LIVE_MODEL=gemini-3.8-live
SOPHIA_LIVE_MODE=

# Migration owner (db:migrate only). Never used by the API or worker.
SOPHIA_MIGRATION_DATABASE_URL=

# apps/studio build (public values): the hosted project URL and publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Filled in by (Supabase), S1-05 (Gemini/LiveKit), S1-06 (images), S1-09 (Omnigent).
# Use credential references, not raw keys, wherever the runtime supports them.
