      "path": "/components/schemas/OwnerRunnerResultRequest",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedOperationRevision": {
            "type": "integer",
            "minimum": 1
          },
          "maxPages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
