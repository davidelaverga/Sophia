            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "deadlineAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "collectionId",
          "projectId",
          "operationId",
          "state",
          "reason",
          "resultId",
          "reservedPages",
          "maxPages",
          "maxBytes",
