          "summary": "The designer's model has the captures of a delivery: the runtime saved each, unchanged, as an attachment. It counts for a submission that names it. Fenced; idempotent.",
          "tags": ["runtime"],
          "security": [
            {
              "runtimeCapability": []
            }
          ],
          "parameters": [
            {
              "name": "x-sophia-runtime-unit",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "maxLength": 160
              }
            },
            {
              "name": "x-sophia-bridge-instance",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "maxLength": 64
              }
            },
            {
              "name": "x-sophia-bridge-protocol",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "enum": ["1"]
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignDeliveryAck"
                }
              }
            }
          },
          "responses": {
