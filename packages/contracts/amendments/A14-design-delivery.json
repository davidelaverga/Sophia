              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "maxLength": 160
              }
            },
            {
              "name": "x-sophia-bridge-instance",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "maxLength": 64
              }
            },
            {
              "name": "x-sophia-bridge-protocol",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "enum": ["1"]
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignDeliveryAck"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The captures now count as seen",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/DesignDeliveryReceipt"
                  }
                }
              }
            },
            "401": {
              "description": "No or unknown runtime capability"
            },
            "403": {
              "description": "The operation names an attempt or native session this runtime does not own, or one whose job is not of this role",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "409": {
              "description": "The work is not active, or the delivery was already acknowledged with other attachments",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "422": {
              "description": "Request fails the declared schema, or names a delivery of another job, attempt or render, or attachments that are not exactly its captures' own bytes",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "503": {
              "description": "Dependent service unavailable",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          },
          "x-sophia-implementation": "implemented",
          "x-sophia-release-goal": "SDD-01"
        }
      }
    }
  ]
}
