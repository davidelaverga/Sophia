    {
      "op": "add",
      "path": "/paths/~1api~1v1~1personal~1answers~1{inputId}~1control",
      "value": {
        "post": {
          "operationId": "controlPersonalAnswer",
          "summary": "Cancel or replace the owner's own admitted automatic answer input, or cancel a held replacement, under its own key and expected control revision. Before its call launched, the original never runs; after, its possible effects are reported, never undone, and its late answer is withheld. A replacement is kept at once, admitted only when the original's money is resolved and paid admission is on, else held with its reason. Served whenever 0103 is installed, whatever the admission flags.",
          "tags": ["personal"],
          "security": [
            {
              "supabaseBearer": []
            }
          ],
          "x-sophia-implementation": "implemented",
          "x-sophia-release-goal": "INC03-CC-003-A3",
          "parameters": [
            {
              "name": "inputId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            },
            {
              "name": "Idempotency-Key",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            {
              "name": "x-sophia-personal-epoch",
              "in": "header",
              "required": true,
              "description": "The epoch of the space the write is made against. A write made against another epoch, so one issued before an erasure however late it arrives, is refused (409 request_erased) and writes nothing.",
              "schema": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,14})$"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalAnswerControlRequest"
                }
              }
            }
          },
          "responses": {
            "202": {
