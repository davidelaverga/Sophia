{
  "id": "A30",
  "goal": "E2E",
  "title": "An admin archives a project, or brings it back",
  "why": [
    "The gaps report (2026-10-15, point 1): a project can be created, renamed (A21) and left (A22), but a finished one stays in everyone's list for good. Archiving is the point's last piece; deleting for good waits for a decision.",
    "POST /api/v1/projects/{projectId}/archive with { archived } archives it or brings it back: an admin only, idempotent per actor and key. A change emits project.archived or project.unarchived; asking for the state it has changes nothing.",
    "Backward compatible: GET /api/v1/projects leaves archived projects out, and ProjectSummary is unchanged, so a Studio still open from before reads the list as it did; GET /api/v1/projects/archived lists them, as a ProjectList."
  ],
  "patch": [
    {
      "op": "add",
      "path": "/components/schemas/ProjectArchiveRequest",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "archived": {
            "type": "boolean"
          }
        },
        "required": ["archived"]
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/ProjectArchived",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "archived": {
            "type": "boolean"
          },
          "cursor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        },
        "required": ["projectId", "archived", "cursor"]
      }
    },
    {
      "op": "add",
      "path": "/paths/~1api~1v1~1projects~1{projectId}~1archive",
      "value": {
        "post": {
          "operationId": "archiveProject",
          "summary": "Archive a project, or bring it back: an admin only, idempotent per actor and key.",
          "tags": ["projects"],
          "security": [
            {
              "supabaseBearer": []
            }
          ],
          "parameters": [
            {
              "name": "projectId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            },
            {
              "name": "Idempotency-Key",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectArchiveRequest"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Archived or brought back (or already so), or the same request again under its key",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ProjectArchived"
                  }
                }
              }
            },
            "401": {
              "description": "Unauthenticated"
            },
            "403": {
              "description": "Not an admin of the project",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "409": {
              "description": "Idempotency mismatch",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "422": {
              "description": "Request fails the declared schema",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/paths/~1api~1v1~1projects~1archived",
      "value": {
        "get": {
          "operationId": "listArchivedProjects",
          "summary": "The caller's archived projects, as their Work side lists them.",
          "tags": ["projects"],
          "security": [
            {
              "supabaseBearer": []
            }
          ],
          "responses": {
            "200": {
              "description": "The caller's archived projects",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ProjectList"
                  }
                }
              }
            },
            "401": {
              "description": "Unauthenticated"
            }
          }
        }
      }
    }
  ]
}
