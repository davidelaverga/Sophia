{
  "id": "A24",
  "goal": "E2E",
  "title": "An admin mutes or removes someone in the call",
  "why": [
    "The gaps report (2026-10-15, point 8): in Meet the host mutes a noisy microphone or takes someone out of the call from the people list; here an admin could do neither.",
    "Two acts on a member in the project's call, for an admin only: mute their microphone (only they turn it on again) and remove them (as a member they may join again). Neither changes a record, so neither takes a key. A guest leaves by the door's Deny (A07), which keeps its pending removal."
  ],
  "patch": [
    {
      "op": "add",
      "path": "/paths/~1api~1v1~1projects~1{projectId}~1room~1people~1{identity}~1mute",
      "value": {
        "post": {
          "operationId": "muteInCall",
          "summary": "Mute a member's microphone in the project's call: an admin only.",
          "tags": ["rooms"],
          "security": [
            {
              "supabaseBearer": []
            }
          ],
          "parameters": [
            {
              "name": "projectId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            },
            {
              "name": "identity",
              "in": "path",
              "required": true,
              "description": "The member's actor id, their identity in the call.",
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "responses": {
            "204": {
              "description": "Done, or already so"
            },
            "401": {
              "description": "Unauthenticated"
            },
            "403": {
              "description": "Not an admin of the project",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "422": {
              "description": "Their own call, or they aren't a member in the call",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "503": {
              "description": "No room server is configured, or it could not be reached",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/paths/~1api~1v1~1projects~1{projectId}~1room~1people~1{identity}~1remove",
      "value": {
        "post": {
          "operationId": "removeFromCall",
          "summary": "Take a member out of the project's call: an admin only.",
          "tags": ["rooms"],
          "security": [
            {
              "supabaseBearer": []
            }
          ],
          "parameters": [
            {
              "name": "projectId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            },
            {
              "name": "identity",
              "in": "path",
              "required": true,
              "description": "The member's actor id, their identity in the call.",
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "responses": {
            "204": {
              "description": "Done, or already so"
            },
            "401": {
              "description": "Unauthenticated"
            },
            "403": {
              "description": "Not an admin of the project",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "422": {
              "description": "Their own call, or they aren't a member in the call",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "503": {
              "description": "No room server is configured, or it could not be reached",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
