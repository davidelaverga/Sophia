{
  "id": "A23",
  "goal": "E2E",
  "title": "The room's chat reads back past its last 50 messages",
  "why": [
    "The gaps report (2026-10-15, point 7): the room's chat held the snapshot's last 50 messages and nothing before them, where Meet's chat, Slack or Teams read the whole conversation by scrolling up.",
    "GET /api/v1/projects/{projectId}/discussion reads the discussion as the snapshot gives it, oldest first, 50 at a time: the newest without `before`, or those just older than that entry with it. The page's `before` is its oldest entry while older ones remain, null at the first message, as A18 proposes for conversations. Members only, as the snapshot."
  ],
  "patch": [
    {
      "op": "add",
      "path": "/components/schemas/DiscussionPage",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entries": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/DiscussionEntry"
            }
          },
          "before": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "description": "The page's oldest entry while older ones remain; null at the first message."
          }
        },
        "required": ["entries", "before"]
      }
    },
    {
      "op": "add",
      "path": "/paths/~1api~1v1~1projects~1{projectId}~1discussion",
      "value": {
        "get": {
          "operationId": "readDiscussion",
          "summary": "A page of the room's discussion, oldest first: the newest 50, or the 50 before an entry.",
          "tags": ["projects"],
          "security": [
            {
              "supabaseBearer": []
            }
          ],
          "parameters": [
            {
              "name": "projectId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            },
            {
              "name": "before",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "The page",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/DiscussionPage"
                  }
                }
              }
            },
            "401": {
              "description": "Unauthenticated"
            },
            "403": {
              "description": "Not a member of the project, or no such project",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "422": {
              "description": "Request fails the declared schema, or `before` names no entry of the discussion",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
