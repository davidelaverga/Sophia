{
  "id": "A63",
  "goal": "INC03-S01c",
  "title": "Saved conversation record-only inputs with structured addressing",
  "why": [
    "A33 and A49 retain their paths and request schemas. The addressed routes have a separate application composition option, with the stock entry point leaving it unset.",
    "The addressed path records member choices and a same-conversation reply reference. Actor, audience, visible target and author are verified by the server.",
    "The response keeps the existing recorded-only receipt. No assessment, attention, work or provider effect follows."
  ],
  "patch": [
    {
      "op": "add",
      "path": "/components/schemas/AddressedConversationInputStart",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interactionContract": {
            "type": "string",
            "enum": ["automatic_v1"],
            "description": "The interaction contract, explicit and required. No other value, no default; a legacy askSophia body is a different request."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "addressingVersion": {
            "type": "integer",
            "enum": [1]
          },
          "mentions": {
            "type": "array",
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "description": "Structured choices of member IDs. Member authority is resolved by the server; textual names are not address IDs."
          }
        },
        "required": ["interactionContract", "title", "text", "addressingVersion", "mentions"],
        "description": "Record one automatic input and its structured address for later observation. The server resolves membership, target visibility and author."
      }
    },
    {
      "op": "add",
      "path": "/paths/~1api~1v1~1projects~1{projectId}~1conversation-inputs~1addressed",
      "value": {
        "post": {
          "operationId": "startAddressedConversationInput",
          "summary": "Record a saved-conversation input with structured addressing",
          "tags": ["conversations"],
          "security": [
            {
              "supabaseBearer": []
            }
          ],
          "x-sophia-implementation": "implemented",
          "x-sophia-release-goal": "INC03-S01c",
          "parameters": [
            {
              "name": "projectId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            {
              "name": "Idempotency-Key",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressedConversationInputStart"
                }
              }
            }
          },
          "responses": {
            "202": {
              "description": "Recorded: the input is retained and nothing follows from it (effect none)",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ConversationInputStarted"
                  }
                }
              }
            },
            "401": {
              "description": "Unauthenticated"
            },
            "403": {
              "description": "Not permitted (not a member; not a writer now, also on a retry; conversations not turned on or read-only: conversations_closed)",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "404": {
              "description": "Addressed conversation inputs are not served by this API."
            },
            "409": {
              "description": "Idempotency key reused with a different request, including a legacy Ask request or the other operation (idempotency_conflict), or a request whose text was since withdrawn or erased (request_erased)",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "422": {
              "description": "Invalid request or address. A fresh address must identify current project members and, for replies, a visible message in the same conversation.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "503": {
              "description": "Addressed inputs are unavailable. An uncertain write must be retried with the same idempotency key.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/AddressedConversationInputSend",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interactionContract": {
            "type": "string",
            "enum": ["automatic_v1"],
            "description": "The interaction contract, explicit and required. No other value, no default; a legacy askSophia body is a different request."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "addressingVersion": {
            "type": "integer",
            "enum": [1]
          },
          "mentions": {
            "type": "array",
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "description": "Structured choices of member IDs. Member authority is resolved by the server; textual names are not address IDs."
          },
          "replyToMessageId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "A visible, nonwithdrawn message from this conversation, or null. The server derives its author."
          }
        },
        "required": ["interactionContract", "text", "addressingVersion", "mentions", "replyToMessageId"],
        "description": "Record one automatic input and its structured address for later observation. The server resolves membership, target visibility and author."
      }
    },
    {
      "op": "add",
      "path": "/paths/~1api~1v1~1conversations~1{conversationId}~1inputs~1addressed",
      "value": {
        "post": {
          "operationId": "sendAddressedConversationInput",
          "summary": "Record a saved-conversation input with structured addressing",
          "tags": ["conversations"],
          "security": [
            {
              "supabaseBearer": []
            }
          ],
          "x-sophia-implementation": "implemented",
          "x-sophia-release-goal": "INC03-S01c",
          "parameters": [
            {
              "name": "conversationId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            {
              "name": "Idempotency-Key",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressedConversationInputSend"
                }
              }
            }
          },
          "responses": {
            "202": {
              "description": "Recorded: the input is retained and nothing follows from it (effect none)",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ConversationInputRecorded"
                  }
                }
              }
            },
            "401": {
              "description": "Unauthenticated"
            },
            "403": {
              "description": "Not permitted (not a member; not a writer now, also on a retry; conversations not turned on or read-only: conversations_closed)",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "404": {
              "description": "Addressed conversation inputs are not served by this API."
            },
            "409": {
              "description": "Idempotency key reused with a different request, including a legacy Ask request or the other operation (idempotency_conflict), or a request whose text was since withdrawn or erased (request_erased)",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "422": {
              "description": "Invalid request or address. A fresh address must identify current project members and, for replies, a visible message in the same conversation.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "503": {
              "description": "Addressed inputs are unavailable. An uncertain write must be retried with the same idempotency key.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
