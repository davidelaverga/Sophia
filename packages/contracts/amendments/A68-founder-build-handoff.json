{
  "id": "A68",
  "goal": "FOUNDER-EXPLORE-TO-BUILD-001",
  "title": "Founder manual Build destination, exact export and reported return",
  "why": [
    "Approve an immutable source in Explore, then use a separate, operator-installed private destination grant to bind a manual Build transfer.",
    "Freeze a destination-bound canonical export manifest. Project the pinned provenance and return evidence through the originating approval.",
    "Report candidate, pull request, merge and deployment evidence as the founder reports it. This contract performs no external release operation or independent verification."
  ],
