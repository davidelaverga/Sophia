    {
      "op": "add",
      "path": "/components/schemas/MediaEvidenceWrite",
      "value": {
        "type": "object",
        "additionalProperties": false,
        "description": "One bridge receipt for an exchange under a grant, by its per-exchange sequence number: the same receipt again is a no-op, another under the same number is refused (409 idempotency_conflict). Only numbers, booleans, enumerated words, ids, digests and times: no free text.",
        "properties": {
          "exchangeId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "grantId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999
          },
          "receipt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VoiceInputWindowReceipt"
              },
              {
                "$ref": "#/components/schemas/VoiceInputTurnReceipt"
              },
              {
                "$ref": "#/components/schemas/VoiceProviderReceipt"
              },
              {
                "$ref": "#/components/schemas/VoiceOutputReplyReceipt"
              },
              {
                "$ref": "#/components/schemas/VoiceSessionClosedReceipt"
              }
            ]
          }
        },
        "required": ["exchangeId", "grantId", "seq", "receipt"]
      }
    },
