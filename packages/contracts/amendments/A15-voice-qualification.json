                "minimum": 1000,
                "maximum": 5000000
              },
              "connectionsOpened": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "turns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "usageTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lastPromptTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endedReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": ["deadline", "expired", "revoked", "connections", "turns", "usage"]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "grantId",
              "runBindingSha256",
              "deadline",
              "expiresAt",
              "revokedAt",
              "maxExchangeSeconds",
              "maxProviderConnections",
              "maxTurns",
              "maxOutputTokensPerTurn",
              "maxUsageTokens",
              "connectionsOpened",
              "turns",
              "usageTokens",
              "lastPromptTokens",
              "endedReason"
            ]
          },
          "receipts": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "enum": ["bridge", "service"]
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99999
                },
                "kind": {
                  "type": "string",
                  "enum": ["input_window", "input_turn", "provider", "output_reply", "session_closed", "guard"]
                },
                "receivedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "receipt": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/VoiceInputWindowReceipt"
                    },
                    {
                      "$ref": "#/components/schemas/VoiceInputTurnReceipt"
                    },
                    {
                      "$ref": "#/components/schemas/VoiceProviderReceipt"
                    },
                    {
                      "$ref": "#/components/schemas/VoiceOutputReplyReceipt"
                    },
                    {
                      "$ref": "#/components/schemas/VoiceSessionClosedReceipt"
                    },
                    {
                      "$ref": "#/components/schemas/VoiceGuardReceipt"
                    }
                  ]
                }
              },
              "required": ["source", "seq", "kind", "receivedAt", "receipt"]
            }
          }
        },
        "required": ["exchangeId", "state", "grant", "receipts"]
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/MediaAssignment/properties/qualification",
      "value": {
        "$ref": "#/components/schemas/VoiceQualification"
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/RoomToken/properties/qualification",
      "value": {
        "$ref": "#/components/schemas/RoomQualification"
      }
    },
    {
      "op": "add",
      "path": "/paths/~1v1~1media~1evidence",
      "value": {
        "post": {
          "operationId": "mediaEvidence",
          "summary": "The bridge's receipt for an exchange under a voice qualification grant. Served only by an API with voice qualification on (SOPHIA_VOICE_QUALIFICATION=on); the bridge sends receipts only with SOPHIA_VOICE_EVIDENCE=on and an assignment that names the grant. The guard runs in the same transaction and may end the exchange.",
          "tags": ["media"],
          "security": [
            {
              "mediaBridgeCapability": []
            }
          ],
          "parameters": [],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaEvidenceWrite"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Recorded, or the same receipt again",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/MediaEvidenceAck"
                  }
                }
              }
            },
            "401": {
              "description": "No or unknown media-bridge capability"
            },
            "403": {
              "description": "The exchange is not under this grant",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "409": {
              "description": "Another receipt holds this sequence number (idempotency_conflict)",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "422": {
              "description": "Request fails the declared schema, or the receipt is not bound to this grant and run",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "503": {
              "description": "Dependent service unavailable"
            }
          },
          "x-sophia-implementation": "implemented",
          "x-sophia-release-goal": "SDD-01-G7"
        }
      }
    },
    {
      "op": "add",
      "path": "/paths/~1api~1v1~1exchanges~1{exchangeId}~1qualification-evidence",
      "value": {
        "get": {
          "operationId": "getQualificationEvidence",
          "summary": "The grant's principal reads what was recorded of an exchange its voice qualification grant covers: the grant's limits, what was reported against them, why the guard ended it, and the receipts kept. Served only by an API with voice qualification on. Read-only; anyone else, or an exchange under no grant, is not found.",
          "tags": ["rooms"],
          "security": [
            {
              "supabaseBearer": []
            }
          ],
          "parameters": [
            {
              "name": "exchangeId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "The evidence",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QualificationEvidence"
                  }
                }
              }
            },
            "401": {
              "description": "Unauthenticated"
            },
            "422": {
              "description": "Not the grant's principal, or no grant covers the exchange (not_found)",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          },
          "x-sophia-implementation": "implemented",
          "x-sophia-release-goal": "SDD-01-G7"
        }
      }
    }
  ]
