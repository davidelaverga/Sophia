{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "mediapipe-assets.ts",
    "vite.fixtures.config.ts",
    "vite.app.config.ts",
    "playwright.config.ts",
    "playwright.served.config.ts",
    "fixtures/**/*.ts",
    "fixtures/**/*.tsx",
    "e2e/**/*.ts",
    "e2e-served/**/*.ts"
  ]
}
