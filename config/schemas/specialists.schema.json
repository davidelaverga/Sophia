{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sophia.invalid/schemas/specialists.v1.json",
  "title": "Sophia specialist registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "description", "specialists"],
  "properties": {
    "schema": { "const": "sophia.specialists.v1" },
    "description": { "type": "string", "minLength": 1 },
    "specialists": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/specialist" } }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}[a-z0-9]$" },
    "specialist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "task_kind",
        "outputs",
        "route",
        "native_tools",
        "output_profile",
        "admission",
        "source_policy",
        "continuation_owner",
        "workflow",
        "peer",
        "raw_host_shell"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^sophia-[a-z]+(-[a-z]+)*-v[0-9]+$" },
        "family": { "$ref": "#/$defs/name" },
        "task_kind": { "enum": ["research", "design", "design_review"] },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["markdown", "pdf", "html", "review"] }
        },
        "route": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$", "not": { "const": "default" } },
        "native_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "output_profile": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*-v[0-9]+$" },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "optional_preferences"],
          "properties": {
            "required": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
            "optional_preferences": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
          }
        },
        "source_policy": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*-v[0-9]+$" },
        "continuation_owner": { "const": "sophia_episode" },
        "workflow": { "const": false },
        "peer": { "const": false },
        "raw_host_shell": { "const": false },
        "prompt_sections": {
          "description": "SDD-01: the bundle prompt sections the preset loads before its first step, by id (hashed bundle assets).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sophia-[a-z]+(-[a-z]+)*$" }
        },
        "skills": {
          "description": "SDD-01: the native skills (packages/dsh-bundle/skills) the preset loads explicitly, never by discovery.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sophia-[a-z]+(-[a-z]+)*-v[0-9]+$" }
        },
        "references": {
          "description": "SDD-01-RF-0002: the bundle references the role may read, read-only, by id or by a `prefix/*` pattern; nothing outside it, whatever skill it belongs to.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]+(/[a-z0-9]+(-[a-z0-9]+)*)*(/\\*)?$" }
        },
        "image_input": {
          "description": "SDD-01: the role inspects real images; it is advertised only on a route that declares image input.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "description": "A research specialist writes its report in Markdown, and may print it as a PDF.",
          "if": { "properties": { "task_kind": { "const": "research" } } },
          "then": {
            "properties": {
              "outputs": { "type": "array", "contains": { "const": "markdown" }, "items": { "enum": ["markdown", "pdf"] } }
            }
          }
        },
        {
          "description": "The designer writes HTML; it loads its prompt sections and skills and needs image input.",
          "if": { "properties": { "task_kind": { "const": "design" } } },
          "then": {
            "properties": {
              "outputs": { "const": ["html"] },
              "prompt_sections": { "type": "array" },
              "skills": { "type": "array" },
              "references": { "type": "array" },
              "image_input": { "const": true }
            },
            "required": ["prompt_sections", "skills", "references", "image_input"]
          }
        },
        {
          "description": "The reviewer writes a review; it loads its prompt sections and skills and needs image input.",
          "if": { "properties": { "task_kind": { "const": "design_review" } } },
          "then": {
            "properties": {
              "outputs": { "const": ["review"] },
              "prompt_sections": { "type": "array" },
              "skills": { "type": "array" },
              "references": { "type": "array" },
              "image_input": { "const": true }
            },
            "required": ["prompt_sections", "skills", "references", "image_input"]
          }
        }
      ]
    }
  }
}
